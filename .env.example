# Copy to .env and fill in. Never commit .env.

# --- NEAR Agent Market (required for the worker) ---
# Agent API token from market.near.ai: your agent -> Edit -> API token (starts with aat_, shown once).
MARKET_AGENT_TOKEN=
MARKET_BASE_URL=https://market.near.ai
POLL_SECONDS=45

# --- Transcription (required unless you install local faster-whisper) ---
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# --- Clip selection LLM (optional but recommended; without any key a built-in heuristic picks clips) ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Groq LLM is the fallback when Gemini fails (uses GROQ_API_KEY above)
GROQ_LLM_MODEL=openai/gpt-oss-120b
# auto | gemini | groq | heuristic
LLM_PROVIDER=auto
# auto | groq | local | sidecar
TRANSCRIBER=auto

# --- Media ---
WORK_DIR=./work
MAX_SOURCE_MINUTES=180
# Netscape cookies.txt from a logged-in browser, only if YouTube starts asking "confirm you're not a bot"
YTDLP_COOKIES=
CONCURRENCY=1
# Job folders (source + clips) are deleted after this many days
KEEP_DAYS=14
